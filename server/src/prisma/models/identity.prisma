// use prisma-8

// Stores user identity and profile information.
model User {
  id                    String                 @id @onCreate(uuid())
  googleId              String                 @unique @map("google_id")
  email                 String                 @unique
  name                  String?
  picture               String?

  googleAccount         GoogleAccount?
  authSessions          AuthSession[]
  oauthStates           OAuthState[]
  mcpAuthorizationCodes McpAuthorizationCode[]
  mcpRefreshTokens      McpRefreshToken[]
  mcpClientAccesses     McpClientAccess[]

  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             temporal.UpdatedAt     @map("updated_at")

  @@map("users")
}

// Stores user authentication sessions.
model AuthSession {
  id        String    @id @onCreate(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// Stores OAuth state values to prevent CSRF attacks.
model OAuthState {
  state      String   @id
  userId     String?  @map("user_id")
  redirectTo String?  @map("redirect_to")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_states")
}
