// use prisma-8

// Stores registered MCP client information.
model McpClient {
  id                 String                 @id @onCreate(uuid())
  clientId           String                 @unique @map("client_id")
  clientSecretHash   String?                @map("client_secret_hash")
  name               String
  redirectUris       String[]               @map("redirect_uris")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          temporal.UpdatedAt     @map("updated_at")

  authorizationCodes McpAuthorizationCode[]
  refreshTokens      McpRefreshToken[]
  userAccesses       McpClientAccess[]

  @@map("mcp_clients")
}

// Stores temporary authorization codes for MCP OAuth.
model McpAuthorizationCode {
  id                  String    @id @onCreate(uuid())
  codeHash            String    @unique @map("code_hash")
  clientId            String    @map("client_id")
  userId              String    @map("user_id")
  redirectUri         String    @map("redirect_uri")
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at")
  usedAt              DateTime? @map("used_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client              McpClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("mcp_authorization_codes")
}

// Stores hashed refresh tokens for MCP clients.
model McpRefreshToken {
  id        String    @id @onCreate(uuid())
  tokenHash String    @unique @map("token_hash")
  clientId  String    @map("client_id")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    McpClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("mcp_refresh_tokens")
}

// Stores user authorization grants for MCP clients.
model McpClientAccess {
  id        String    @id @onCreate(uuid())
  userId    String    @map("user_id")
  clientId  String    @map("client_id")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    McpClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
  @@map("mcp_client_accesses")
}
