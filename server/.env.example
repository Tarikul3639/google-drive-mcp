# Application Configuration
PORT=5000
NODE_ENV=development

# Google OAuth Configuration
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_FOR_DEVELOPMENT_ONLY
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_FOR_DEVELOPMENT_ONLY
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_DRIVE_CALLBACK_URL=http://localhost:3000/google-integration/callback
# Google Token Encryption Key (64-character hex string)
GOOGLE_TOKEN_ENCRYPTION_KEY=your_64_character_hex_key

# Database Configuration
DATABASE_URL="postgresql://google_drive_user:123456789@localhost:5432/google_drive_mcp"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Session Configuration
SESSION_TTL=7d
SESSION_COOKIE_NAME=session

# JWT Configuration
JWT_ACCESS_SECRET=your-strong-random-secret
JWT_ACCESS_TTL=15m

REFRESH_TOKEN_TTL=30d

# Frontend Configuration
FRONTEND_URL=http://localhost:3001

# Authentication Configuration
JWT_SECRET=JWT_SECRET_FOR_DEVELOPMENT_ONLY

# Cookie Names
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# MCP Configuration
MCP_RESOURCE=http://localhost:5000/api/mcp
MCP_AUTHORIZATION_SERVER=http://localhost:5000
# MCP Google OAuth Callback URL
MCP_GOOGLE_CALLBACK_URL=http://localhost:5000/api/mcp/oauth/google/callback